# Supabase — create a free project at https://supabase.com
# Run supabase/schema.sql in the SQL editor, then enable Realtime on user_sync_data.
#
# Copy this file to .env and fill in real values (never commit .env).
#
# Project URL (Settings → API, or Connect dialog):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
#
# Publishable key ONLY (sb_publishable_...) — safe for browser/desktop app.
# Do NOT put sb_secret_... here — that bypasses all security.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Netlify sets VITE_BASE=/ automatically via netlify.toml
# Desktop/Electron builds use the default base path ./
